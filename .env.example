# ==============================================================================
# GENESIS - Environment Variables Configuration
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
LOG_LEVEL=INFO

# Security & Tokens
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=genesis_development_secret_key_please_change_in_production_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - PostgreSQL + pgvector
POSTGRES_USER=genesis_user
POSTGRES_PASSWORD=genesis_secret_password
POSTGRES_DB=genesis_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://genesis_user:genesis_secret_password@localhost:5432/genesis_db
DATABASE_URL_SYNC=postgresql://genesis_user:genesis_secret_password@localhost:5432/genesis_db

# Redis - Cache, Stream Bus, Task Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Knowledge Graph - Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=genesis_graph_pass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Object Storage - S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=genesis_admin
S3_SECRET_KEY=genesis_minio_pass
S3_BUCKET_NAME=genesis-documents
S3_REGION=us-east-1

# External AI Providers
OPENAI_API_KEY=
COHERE_API_KEY=

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Client App
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
